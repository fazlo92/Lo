[
 {
  "para": 0,
  "text": "Apa jadi kalau semua rumah di Kuching bela seekor kucing?",
  "start": 0.02,
  "end": 3.54
 },
 {
  "para": 1,
  "text": "Bayangkan…",
  "start": 3.58,
  "end": 4.64
 },
 {
  "para": 1,
  "text": "esok pagi,",
  "start": 4.75,
  "end": 5.66
 },
 {
  "para": 1,
  "text": "setiap rumah di Kuching menyambut seekor kucing baharu.",
  "start": 6.12,
  "end": 8.54
 },
 {
  "para": 2,
  "text": "Berdasarkan Banci 2020,",
  "start": 9.0,
  "end": 10.62
 },
 {
  "para": 2,
  "text": "Bahagian Kuching mempunyai 162,802 isi rumah.",
  "start": 10.76,
  "end": 15.56
 },
 {
  "para": 2,
  "text": "Satu rumah,",
  "start": 15.68,
  "end": 16.34
 },
 {
  "para": 2,
  "text": "satu kucing.",
  "start": 16.54,
  "end": 17.04
 },
 {
  "para": 2,
  "text": "Dari Satok hingga Lundu…",
  "start": 17.26,
  "end": 18.8
 },
 {
  "para": 2,
  "text": "162,802 ekor kucing!",
  "start": 18.94,
  "end": 22.68
 },
 {
  "para": 3,
  "text": "Minggu pertama.",
  "start": 23.48,
  "end": 24.28
 },
 {
  "para": 3,
  "text": "Katakan seekor kucing makan 60 gram sehari.",
  "start": 24.68,
  "end": 27.44
 },
 {
  "para": 3,
  "text": "Darab dengan 162,802…",
  "start": 27.68,
  "end": 30.32
 },
 {
  "para": 3,
  "text": "hampir 9.8 tan makanan setiap hari!",
  "start": 30.7,
  "end": 33.9
 },
 {
  "para": 3,
  "text": "Itu hampir 1,000 beg makanan sehari.",
  "start": 34.02,
  "end": 36.96
 },
 {
  "para": 4,
  "text": "Bulan pertama.",
  "start": 36.89,
  "end": 38.28
 },
 {
  "para": 4,
  "text": "Pada harga RM15 sekilo,",
  "start": 38.44,
  "end": 40.22
 },
 {
  "para": 4,
  "text": "seekor kucing cuma 90 sen sehari.",
  "start": 40.36,
  "end": 42.58
 },
 {
  "para": 4,
  "text": "Nampak kecil,",
  "start": 42.68,
  "end": 43.54
 },
 {
  "para": 4,
  "text": "kan?",
  "start": 43.76,
  "end": 44.0
 },
 {
  "para": 4,
  "text": "Tetapi darab dengan semua kucing…",
  "start": 44.58,
  "end": 46.0
 },
 {
  "para": 4,
  "text": "hampir RM147,000 sehari.",
  "start": 46.2,
  "end": 48.48
 },
 {
  "para": 4,
  "text": "Sebulan,",
  "start": 48.66,
  "end": 49.32
 },
 {
  "para": 4,
  "text": "RM4.4 juta!",
  "start": 49.42,
  "end": 51.68
 },
 {
  "para": 5,
  "text": "Bulan ketiga.",
  "start": 51.52,
  "end": 53.2
 },
 {
  "para": 5,
  "text": "40 gram najis seekor sehari…",
  "start": 53.34,
  "end": 55.14
 },
 {
  "para": 5,
  "text": "menjadi 6.5 tan sehari.",
  "start": 55.26,
  "end": 57.32
 },
 {
  "para": 5,
  "text": "Sebulan,",
  "start": 57.5,
  "end": 58.02
 },
 {
  "para": 5,
  "text": "hampir 195 tan!",
  "start": 58.18,
  "end": 60.18
 },
 {
  "para": 6,
  "text": "Bulan keenam.",
  "start": 60.16,
  "end": 61.72
 },
 {
  "para": 6,
  "text": "Kalau hanya 10% betina tidak dimandulkan,",
  "start": 61.9,
  "end": 64.62
 },
 {
  "para": 6,
  "text": "dan setiap seekor melahirkan empat anak…",
  "start": 64.78,
  "end": 66.92
 },
 {
  "para": 6,
  "text": "lebih 65,000 anak kucing lahir!",
  "start": 67.02,
  "end": 70.0
 },
 {
  "para": 6,
  "text": "Jumlahnya kini melebihi 227,000 ekor.",
  "start": 70.14,
  "end": 73.4
 },
 {
  "para": 7,
  "text": "Setahun kemudian.",
  "start": 73.86,
  "end": 74.8
 },
 {
  "para": 7,
  "text": "Lebih 3,500 tan makanan.",
  "start": 74.92,
  "end": 77.24
 },
 {
  "para": 7,
  "text": "Kos melebihi RM53 juta!",
  "start": 77.4,
  "end": 80.1
 },
 {
  "para": 8,
  "text": "Seekor kucing nampak kecil.",
  "start": 80.58,
  "end": 82.64
 },
 {
  "para": 8,
  "text": "Tetapi apabila didarab dengan seluruh Kuching…",
  "start": 82.78,
  "end": 85.46
 },
 {
  "para": 8,
  "text": "setiap angka menjadi sangat besar.",
  "start": 85.6,
  "end": 87.48
 },
 {
  "para": 9,
  "text": "Kuching memang Bandar Raya Kucing.",
  "start": 87.96,
  "end": 90.02
 },
 {
  "para": 9,
  "text": "Tetapi bela kucing bukan sekadar comel…",
  "start": 90.18,
  "end": 92.66
 },
 {
  "para": 9,
  "text": "ia tanggungjawab.",
  "start": 92.76,
  "end": 93.66
 },
 {
  "para": 9,
  "text": "Jaga dengan baik,",
  "start": 93.8,
  "end": 94.62
 },
 {
  "para": 9,
  "text": "dan mandulkan.",
  "start": 94.68,
  "end": 95.4
 },
 {
  "para": 10,
  "text": "Apa jadi kalau…",
  "start": 95.84,
  "end": 96.78
 },
 {
  "para": 10,
  "text": "perkara lain pula?",
  "start": 96.92,
  "end": 97.76
 },
 {
  "para": 10,
  "text": "Tulis di ruang komen!",
  "start": 97.92,
  "end": 98.96
 }
]