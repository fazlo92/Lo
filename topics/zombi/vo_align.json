[
 {
  "para": 0,
  "text": "Apa jadi kalau wabak zombi berlaku di Kuching?",
  "start": 0.3,
  "end": 1.3
 },
 {
  "para": 0,
  "text": "Bayangkan…",
  "start": 4.99,
  "end": 5.99
 },
 {
  "para": 0,
  "text": "esok pagi,",
  "start": 5.72,
  "end": 6.72
 },
 {
  "para": 0,
  "text": "satu wabak misteri mula merebak di Kuching.",
  "start": 6.74,
  "end": 7.74
 },
 {
  "para": 0,
  "text": "Mula-mula,",
  "start": 9.65,
  "end": 10.65
 },
 {
  "para": 0,
  "text": "hanya seorang pesakit.",
  "start": 10.58,
  "end": 11.58
 },
 {
  "para": 0,
  "text": "Tujuh hari kemudian…",
  "start": 12.12,
  "end": 13.12
 },
 {
  "para": 0,
  "text": "seluruh bandar berubah.",
  "start": 13.84,
  "end": 14.84
 },
 {
  "para": 1,
  "text": "Hari pertama.",
  "start": 16.4,
  "end": 17.4
 },
 {
  "para": 1,
  "text": "Seorang lelaki tiba di Hospital Umum Sarawak dengan demam panas…",
  "start": 18.13,
  "end": 19.13
 },
 {
  "para": 1,
  "text": "dan tingkah laku agresif.",
  "start": 22.43,
  "end": 23.43
 },
 {
  "para": 1,
  "text": "Menjelang malam,",
  "start": 26.56,
  "end": 27.46
 },
 {
  "para": 1,
  "text": "kejadian serupa dilaporkan di MetroCity dan Petra Jaya.",
  "start": 27.78,
  "end": 31.04
 },
 {
  "para": 2,
  "text": "Hari kedua.",
  "start": 31.52,
  "end": 32.5
 },
 {
  "para": 2,
  "text": "Rakaman serangan di Waterfront menjadi tular.",
  "start": 32.62,
  "end": 35.88
 },
 {
  "para": 2,
  "text": "Pengunjung VivaCity dan The Spring bergegas keluar.",
  "start": 36.04,
  "end": 39.32
 },
 {
  "para": 2,
  "text": "Jalan ke Jambatan Satok mula sesak.",
  "start": 38.96,
  "end": 41.74
 },
 {
  "para": 3,
  "text": "Hari ketiga.",
  "start": 42.22,
  "end": 43.16
 },
 {
  "para": 3,
  "text": "Sekolah ditutup.",
  "start": 43.28,
  "end": 44.38
 },
 {
  "para": 3,
  "text": "Di Jalan Tun Jugah,",
  "start": 44.52,
  "end": 45.48
 },
 {
  "para": 3,
  "text": "kereta ditinggalkan di tengah kesesakan.",
  "start": 45.68,
  "end": 48.22
 },
 {
  "para": 3,
  "text": "Rak pasar raya kosong akibat pembelian panik.",
  "start": 48.32,
  "end": 51.2
 },
 {
  "para": 4,
  "text": "Hari keempat.",
  "start": 51.7,
  "end": 52.54
 },
 {
  "para": 4,
  "text": "Kuching diisytiharkan zon kecemasan.",
  "start": 52.7,
  "end": 55.7
 },
 {
  "para": 4,
  "text": "Laluan keluar dikawal.",
  "start": 55.8,
  "end": 57.34
 },
 {
  "para": 4,
  "text": "Bas di Kuching Sentral tidak lagi bergerak.",
  "start": 57.44,
  "end": 59.52
 },
 {
  "para": 4,
  "text": "Penerbangan di Lapangan Terbang Antarabangsa Kuching dihentikan.",
  "start": 59.68,
  "end": 63.48
 },
 {
  "para": 4,
  "text": "Tetapi wabak terus merebak.",
  "start": 63.64,
  "end": 65.74
 },
 {
  "para": 5,
  "text": "Hari kelima.",
  "start": 66.24,
  "end": 67.3
 },
 {
  "para": 5,
  "text": "Waterfront kosong.",
  "start": 67.4,
  "end": 68.76
 },
 {
  "para": 5,
  "text": "Kedai-kedai di MetroCity tutup.",
  "start": 68.92,
  "end": 71.08
 },
 {
  "para": 5,
  "text": "Lampu jalan mula padam.",
  "start": 71.18,
  "end": 72.94
 },
 {
  "para": 5,
  "text": "Penduduk berlindung di dalam rumah.",
  "start": 73.1,
  "end": 75.02
 },
 {
  "para": 6,
  "text": "Hari keenam.",
  "start": 75.5,
  "end": 76.44
 },
 {
  "para": 6,
  "text": "Sekumpulan penduduk berkumpul di pusat perlindungan.",
  "start": 76.58,
  "end": 79.2
 },
 {
  "para": 6,
  "text": "Mereka menghubungi pasukan penyelamat melalui radio.",
  "start": 79.3,
  "end": 82.32
 },
 {
  "para": 7,
  "text": "Hari ketujuh.",
  "start": 82.82,
  "end": 83.86
 },
 {
  "para": 7,
  "text": "Kumpulan terakhir dipindahkan dengan helikopter.",
  "start": 84.02,
  "end": 86.94
 },
 {
  "para": 7,
  "text": "Dari udara,",
  "start": 87.06,
  "end": 87.84
 },
 {
  "para": 7,
  "text": "Kuching sunyi.",
  "start": 88.0,
  "end": 89.38
 },
 {
  "para": 7,
  "text": "Jambatan Darul Hana masih berdiri…",
  "start": 89.52,
  "end": 91.72
 },
 {
  "para": 7,
  "text": "tetapi kehidupan bandar telah terhenti.",
  "start": 91.88,
  "end": 94.58
 },
 {
  "para": 8,
  "text": "Kemudian…",
  "start": 95.0,
  "end": 95.76
 },
 {
  "para": 8,
  "text": "satu panggilan radio.",
  "start": 95.88,
  "end": 97.86
 },
 {
  "para": 8,
  "text": "Ini pusat kawalan…",
  "start": 97.32,
  "end": 99.04
 },
 {
  "para": 8,
  "text": "kami menerima laporan jangkitan baharu di Sibu.",
  "start": 99.2,
  "end": 101.54
 },
 {
  "para": 9,
  "text": "Rupa-rupanya,",
  "start": 102.02,
  "end": 102.86
 },
 {
  "para": 9,
  "text": "Kuching hanyalah permulaan.",
  "start": 103.02,
  "end": 104.98
 },
 {
  "para": 10,
  "text": "Kalau wabak zombi berlaku di Kuching…",
  "start": 105.4,
  "end": 107.26
 },
 {
  "para": 10,
  "text": "ke mana korang akan lari dulu?",
  "start": 107.48,
  "end": 108.86
 },
 {
  "para": 10,
  "text": "Tulis di ruang komen!",
  "start": 109.02,
  "end": 110.06
 }
]