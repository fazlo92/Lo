[
 {
  "para": 0,
  "text": "Esok pagi,",
  "start": 0.04,
  "end": 0.73
 },
 {
  "para": 0,
  "text": "semua orang di Kuching bangun…",
  "start": 0.73,
  "end": 2.7
 },
 {
  "para": 0,
  "text": "dan tiba-tiba tak pandai matematik.",
  "start": 3.09,
  "end": 4.88
 },
 {
  "para": 0,
  "text": "Jam loceng berbunyi —",
  "start": 5.27,
  "end": 6.15
 },
 {
  "para": 0,
  "text": "tapi tiada siapa tahu pukul berapa.",
  "start": 6.15,
  "end": 8.78
 },
 {
  "para": 1,
  "text": "Pukul tujuh setengah,",
  "start": 9.26,
  "end": 10.47
 },
 {
  "para": 1,
  "text": "gerai laksa.",
  "start": 10.47,
  "end": 11.16
 },
 {
  "para": 1,
  "text": "Semangkuk laksa Sarawak lapan ringgit.",
  "start": 11.55,
  "end": 13.1
 },
 {
  "para": 1,
  "text": "Anda bayar sepuluh —",
  "start": 13.49,
  "end": 15.16
 },
 {
  "para": 1,
  "text": "peniaga pulangkan lapan puluh.",
  "start": 15.16,
  "end": 18.26
 },
 {
  "para": 2,
  "text": "Pukul sembilan,",
  "start": 18.74,
  "end": 19.29
 },
 {
  "para": 2,
  "text": "di Medan Niaga Satok.",
  "start": 19.55,
  "end": 20.39
 },
 {
  "para": 2,
  "text": "Nak beli ikan terubuk masin.",
  "start": 20.78,
  "end": 22.0
 },
 {
  "para": 2,
  "text": "Penimbang tunjuk dua kilo —",
  "start": 22.27,
  "end": 23.54
 },
 {
  "para": 2,
  "text": "peniaga baca dua puluh.",
  "start": 23.8,
  "end": 25.23
 },
 {
  "para": 2,
  "text": "Diskaun lima puluh peratus —",
  "start": 25.49,
  "end": 26.35
 },
 {
  "para": 2,
  "text": "harga jadi lebih mahal.",
  "start": 26.61,
  "end": 27.73
 },
 {
  "para": 3,
  "text": "Pukul sepuluh.",
  "start": 28.21,
  "end": 28.77
 },
 {
  "para": 3,
  "text": "Hari gaji.",
  "start": 29.03,
  "end": 29.74
 },
 {
  "para": 3,
  "text": "Tapi tiada siapa boleh kira baki akaun.",
  "start": 30.13,
  "end": 32.5
 },
 {
  "para": 3,
  "text": "Bank tutup kaunter.",
  "start": 32.5,
  "end": 33.5
 },
 {
  "para": 4,
  "text": "Pukul sebelas.",
  "start": 33.5,
  "end": 34.24
 },
 {
  "para": 4,
  "text": "Had laju tak bermakna apa-apa.",
  "start": 34.64,
  "end": 37.03
 },
 {
  "para": 4,
  "text": "Pam minyak tak tahu bila nak berhenti.",
  "start": 37.29,
  "end": 38.96
 },
 {
  "para": 4,
  "text": "Jalan raya lumpuh.",
  "start": 39.22,
  "end": 40.24
 },
 {
  "para": 5,
  "text": "Tengah hari,",
  "start": 40.72,
  "end": 41.52
 },
 {
  "para": 5,
  "text": "Lapangan Terbang Antarabangsa Kuching.",
  "start": 41.73,
  "end": 43.28
 },
 {
  "para": 5,
  "text": "Juruterbang tak boleh kira bahan api atau ketinggian.",
  "start": 43.67,
  "end": 47.76
 },
 {
  "para": 5,
  "text": "Semua penerbangan —",
  "start": 48.02,
  "end": 49.62
 },
 {
  "para": 5,
  "text": "dibatalkan.",
  "start": 50.01,
  "end": 50.4
 },
 {
  "para": 6,
  "text": "Pukul dua petang,",
  "start": 50.88,
  "end": 52.31
 },
 {
  "para": 6,
  "text": "Hospital Umum Sarawak.",
  "start": 52.58,
  "end": 53.47
 },
 {
  "para": 6,
  "text": "Dua biji sehari…",
  "start": 53.86,
  "end": 54.92
 },
 {
  "para": 6,
  "text": "atau dua puluh?",
  "start": 55.18,
  "end": 56.55
 },
 {
  "para": 6,
  "text": "Doktor tak berani beri ubat.",
  "start": 56.94,
  "end": 58.86
 },
 {
  "para": 7,
  "text": "Pukul empat.",
  "start": 58.86,
  "end": 59.53
 },
 {
  "para": 7,
  "text": "Jambatan baru di Waterfront dibina dari dua tebing…",
  "start": 59.53,
  "end": 63.04
 },
 {
  "para": 7,
  "text": "dan tak bertemu di tengah sungai.",
  "start": 63.43,
  "end": 65.37
 },
 {
  "para": 8,
  "text": "Pukul enam.",
  "start": 65.37,
  "end": 66.07
 },
 {
  "para": 8,
  "text": "Loji air tak boleh sukat klorin.",
  "start": 66.33,
  "end": 67.71
 },
 {
  "para": 8,
  "text": "Janakuasa tak boleh kira voltan.",
  "start": 67.97,
  "end": 70.02
 },
 {
  "para": 8,
  "text": "Air paip berhenti.",
  "start": 70.29,
  "end": 71.09
 },
 {
  "para": 8,
  "text": "Lampu padam.",
  "start": 71.48,
  "end": 72.18
 },
 {
  "para": 9,
  "text": "Pukul sembilan malam.",
  "start": 72.66,
  "end": 73.69
 },
 {
  "para": 9,
  "text": "Kuching gelap gelita.",
  "start": 73.95,
  "end": 75.18
 },
 {
  "para": 9,
  "text": "Bantuan tak tahu berapa ramai perlu ditolong…",
  "start": 75.18,
  "end": 78.42
 },
 {
  "para": 9,
  "text": "atau berapa jauh perlu pergi.",
  "start": 78.81,
  "end": 80.35
 },
 {
  "para": 10,
  "text": "Baru kita sedar.",
  "start": 80.83,
  "end": 82.64
 },
 {
  "para": 10,
  "text": "Matematik bukan cuma dalam kelas.",
  "start": 82.9,
  "end": 85.71
 },
 {
  "para": 10,
  "text": "Ia ada dalam laksa pagi kita,",
  "start": 85.71,
  "end": 88.31
 },
 {
  "para": 10,
  "text": "jambatan yang kita lalu,",
  "start": 88.57,
  "end": 90.61
 },
 {
  "para": 10,
  "text": "air yang kita minum —",
  "start": 91.0,
  "end": 91.7
 },
 {
  "para": 10,
  "text": "dan setiap nyawa yang diselamatkan.",
  "start": 91.96,
  "end": 93.75
 },
 {
  "para": 11,
  "text": "Apa jadi kalau…",
  "start": 94.22,
  "end": 95.09
 },
 {
  "para": 11,
  "text": "apa pula?",
  "start": 95.35,
  "end": 96.37
 },
 {
  "para": 11,
  "text": "Tulis di ruang komen.",
  "start": 96.77,
  "end": 97.98
 }
]