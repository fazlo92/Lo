[
 {
  "para": 0,
  "text": "Esok pagi,",
  "start": 0.04,
  "end": 3.4
 },
 {
  "para": 0,
  "text": "seluruh Kuching bangun…",
  "start": 3.52,
  "end": 5.82
 },
 {
  "para": 0,
  "text": "dan tiba-tiba semua orang tak pandai Matematik.",
  "start": 6.02,
  "end": 9.02
 },
 {
  "para": 1,
  "text": "Jam loceng berbunyi.",
  "start": 9.48,
  "end": 10.52
 },
 {
  "para": 1,
  "text": "Tapi tiada siapa tahu pukul berapa.",
  "start": 10.68,
  "end": 12.92
 },
 {
  "para": 2,
  "text": "7.30 pagi.",
  "start": 13.36,
  "end": 14.3
 },
 {
  "para": 2,
  "text": "Di gerai laksa.",
  "start": 14.46,
  "end": 15.46
 },
 {
  "para": 2,
  "text": "Semangkuk laksa Sarawak berharga RM8.",
  "start": 15.6,
  "end": 18.34
 },
 {
  "para": 2,
  "text": "Bayar RM10,",
  "start": 18.46,
  "end": 19.54
 },
 {
  "para": 2,
  "text": "peniaga pulangkan RM80.",
  "start": 19.66,
  "end": 21.18
 },
 {
  "para": 3,
  "text": "9.00 pagi.",
  "start": 21.66,
  "end": 22.42
 },
 {
  "para": 3,
  "text": "Di Medan Niaga Satok.",
  "start": 22.56,
  "end": 23.88
 },
 {
  "para": 3,
  "text": "Nak beli ikan terubuk masin.",
  "start": 23.96,
  "end": 25.5
 },
 {
  "para": 3,
  "text": "Penimbang tunjuk 2 kilogram,",
  "start": 25.68,
  "end": 27.34
 },
 {
  "para": 3,
  "text": "peniaga baca 20 kilogram.",
  "start": 27.52,
  "end": 29.26
 },
 {
  "para": 3,
  "text": "Diskaun 50%,",
  "start": 29.38,
  "end": 30.54
 },
 {
  "para": 3,
  "text": "tapi harga makin mahal!",
  "start": 30.68,
  "end": 32.08
 },
 {
  "para": 4,
  "text": "10.00 pagi.",
  "start": 32.56,
  "end": 33.32
 },
 {
  "para": 4,
  "text": "Hari gaji!",
  "start": 33.48,
  "end": 34.56
 },
 {
  "para": 4,
  "text": "Tapi tiada siapa tahu cara mengira baki akaun.",
  "start": 34.74,
  "end": 37.76
 },
 {
  "para": 4,
  "text": "Kaunter bank terpaksa ditutup.",
  "start": 38.02,
  "end": 39.54
 },
 {
  "para": 5,
  "text": "11.00 pagi.",
  "start": 40.02,
  "end": 40.9
 },
 {
  "para": 5,
  "text": "Had laju tak lagi bermakna.",
  "start": 41.28,
  "end": 42.88
 },
 {
  "para": 5,
  "text": "Nak isi minyak pun tak tahu berapa liter.",
  "start": 43.08,
  "end": 45.16
 },
 {
  "para": 5,
  "text": "Jalan raya mula sesak.",
  "start": 45.28,
  "end": 46.56
 },
 {
  "para": 6,
  "text": "12.00 tengah hari.",
  "start": 47.0,
  "end": 48.26
 },
 {
  "para": 6,
  "text": "Di Lapangan Terbang Antarabangsa Kuching.",
  "start": 48.42,
  "end": 50.24
 },
 {
  "para": 6,
  "text": "Pramugari gagal mengira jumlah penumpang.",
  "start": 50.4,
  "end": 52.8
 },
 {
  "para": 6,
  "text": "Juruterbang tak dapat membaca ketinggian pesawat.",
  "start": 52.92,
  "end": 55.3
 },
 {
  "para": 6,
  "text": "Semua penerbangan dibatalkan.",
  "start": 55.44,
  "end": 57.32
 },
 {
  "para": 7,
  "text": "2.00 petang.",
  "start": 57.78,
  "end": 58.56
 },
 {
  "para": 7,
  "text": "Di Hospital Umum Sarawak.",
  "start": 58.68,
  "end": 60.54
 },
 {
  "para": 7,
  "text": "Dua biji ubat sehari…",
  "start": 60.64,
  "end": 62.0
 },
 {
  "para": 7,
  "text": "atau dua puluh?",
  "start": 62.1,
  "end": 63.52
 },
 {
  "para": 7,
  "text": "Doktor tak berani memberikan ubat.",
  "start": 63.64,
  "end": 65.28
 },
 {
  "para": 8,
  "text": "4.00 petang.",
  "start": 65.74,
  "end": 66.76
 },
 {
  "para": 8,
  "text": "Sebuah jambatan baharu dibina dari dua tebing Sungai Sarawak.",
  "start": 66.88,
  "end": 70.22
 },
 {
  "para": 8,
  "text": "Tapi kedua-dua bahagian tak bertemu di tengah!",
  "start": 70.38,
  "end": 72.9
 },
 {
  "para": 9,
  "text": "6.00 petang.",
  "start": 73.32,
  "end": 74.34
 },
 {
  "para": 9,
  "text": "Sukatan klorin di loji air tersilap.",
  "start": 74.48,
  "end": 76.42
 },
 {
  "para": 9,
  "text": "Jurutera gagal mengira voltan.",
  "start": 76.64,
  "end": 78.44
 },
 {
  "para": 9,
  "text": "Bekalan air terhenti.",
  "start": 78.54,
  "end": 80.2
 },
 {
  "para": 9,
  "text": "Lampu padam.",
  "start": 80.3,
  "end": 81.06
 },
 {
  "para": 9,
  "text": "Internet terputus.",
  "start": 81.2,
  "end": 82.22
 },
 {
  "para": 10,
  "text": "9.00 malam.",
  "start": 82.7,
  "end": 83.58
 },
 {
  "para": 10,
  "text": "Kuching gelap gelita.",
  "start": 83.94,
  "end": 85.44
 },
 {
  "para": 10,
  "text": "Pasukan penyelamat tak tahu berapa ramai yang perlu diselamatkan…",
  "start": 85.8,
  "end": 88.56
 },
 {
  "para": 10,
  "text": "atau sejauh mana mereka perlu pergi.",
  "start": 88.68,
  "end": 90.66
 },
 {
  "para": 11,
  "text": "Akhirnya,",
  "start": 91.1,
  "end": 91.82
 },
 {
  "para": 11,
  "text": "baru kita sedar.",
  "start": 91.96,
  "end": 92.98
 },
 {
  "para": 12,
  "text": "Matematik bukan sekadar subjek di sekolah.",
  "start": 93.44,
  "end": 95.9
 },
 {
  "para": 13,
  "text": "Ia ada dalam setiap urusan harian,",
  "start": 96.34,
  "end": 98.74
 },
 {
  "para": 13,
  "text": "setiap jambatan yang kita lalui,",
  "start": 98.86,
  "end": 100.52
 },
 {
  "para": 13,
  "text": "setiap titis air yang kita minum…",
  "start": 100.66,
  "end": 102.48
 },
 {
  "para": 13,
  "text": "malah dalam setiap nyawa yang diselamatkan.",
  "start": 102.58,
  "end": 105.0
 },
 {
  "para": 14,
  "text": "Tanpa Matematik,",
  "start": 105.46,
  "end": 106.44
 },
 {
  "para": 14,
  "text": "dunia yang kita kenal mungkin terhenti.",
  "start": 106.58,
  "end": 108.72
 },
 {
  "para": 15,
  "text": "Apa jadi kalau…",
  "start": 109.18,
  "end": 110.32
 },
 {
  "para": 15,
  "text": "perkara lain pula berlaku?",
  "start": 110.48,
  "end": 111.7
 },
 {
  "para": 16,
  "text": "Tulis idea anda di ruang komen!",
  "start": 112.2,
  "end": 113.88
 }
]