[
 {
  "para": 0,
  "text": "Esok pagi,",
  "start": 0.05,
  "end": 0.86
 },
 {
  "para": 0,
  "text": "semua orang di Kuching bangun…",
  "start": 1.15,
  "end": 2.7
 },
 {
  "para": 0,
  "text": "dan tiba-tiba tak pandai matematik.",
  "start": 2.99,
  "end": 4.73
 },
 {
  "para": 0,
  "text": "Jam loceng berbunyi —",
  "start": 5.16,
  "end": 6.27
 },
 {
  "para": 0,
  "text": "tapi tiada siapa tahu pukul berapa.",
  "start": 6.56,
  "end": 8.57
 },
 {
  "para": 1,
  "text": "Pukul tujuh setengah,",
  "start": 9.1,
  "end": 10.02
 },
 {
  "para": 1,
  "text": "gerai laksa.",
  "start": 10.31,
  "end": 11.07
 },
 {
  "para": 1,
  "text": "Semangkuk laksa Sarawak lapan ringgit.",
  "start": 11.35,
  "end": 13.26
 },
 {
  "para": 1,
  "text": "Anda bayar sepuluh —",
  "start": 13.69,
  "end": 14.58
 },
 {
  "para": 1,
  "text": "peniaga pulangkan lapan puluh.",
  "start": 15.01,
  "end": 16.32
 },
 {
  "para": 2,
  "text": "Pukul sembilan,",
  "start": 16.84,
  "end": 17.56
 },
 {
  "para": 2,
  "text": "di Medan Niaga Satok.",
  "start": 17.75,
  "end": 18.75
 },
 {
  "para": 2,
  "text": "Nak beli ikan terubuk masin.",
  "start": 19.04,
  "end": 20.6
 },
 {
  "para": 2,
  "text": "Penimbang tunjuk dua kilo —",
  "start": 21.03,
  "end": 22.42
 },
 {
  "para": 2,
  "text": "peniaga baca dua puluh.",
  "start": 22.7,
  "end": 23.83
 },
 {
  "para": 2,
  "text": "Diskaun lima puluh peratus —",
  "start": 24.26,
  "end": 25.53
 },
 {
  "para": 2,
  "text": "harga jadi lebih mahal.",
  "start": 25.82,
  "end": 27.13
 },
 {
  "para": 3,
  "text": "Pukul sepuluh.",
  "start": 27.65,
  "end": 28.28
 },
 {
  "para": 3,
  "text": "Hari gaji.",
  "start": 28.56,
  "end": 29.09
 },
 {
  "para": 3,
  "text": "Tapi tiada siapa boleh kira baki akaun.",
  "start": 29.38,
  "end": 31.53
 },
 {
  "para": 3,
  "text": "Bank tutup kaunter.",
  "start": 31.96,
  "end": 32.82
 },
 {
  "para": 4,
  "text": "Pukul sebelas.",
  "start": 33.35,
  "end": 34.19
 },
 {
  "para": 4,
  "text": "Had laju tak bermakna apa-apa.",
  "start": 34.47,
  "end": 36.22
 },
 {
  "para": 4,
  "text": "Pam minyak tak tahu bila nak berhenti.",
  "start": 36.46,
  "end": 38.15
 },
 {
  "para": 4,
  "text": "Jalan raya lumpuh.",
  "start": 38.58,
  "end": 39.55
 },
 {
  "para": 5,
  "text": "Tengah hari,",
  "start": 40.07,
  "end": 40.53
 },
 {
  "para": 5,
  "text": "Lapangan Terbang Antarabangsa Kuching.",
  "start": 40.82,
  "end": 42.32
 },
 {
  "para": 5,
  "text": "Juruterbang tak boleh kira bahan api atau ketinggian.",
  "start": 42.61,
  "end": 45.15
 },
 {
  "para": 5,
  "text": "Semua penerbangan —",
  "start": 45.43,
  "end": 46.43
 },
 {
  "para": 5,
  "text": "dibatalkan.",
  "start": 46.71,
  "end": 47.29
 },
 {
  "para": 6,
  "text": "Pukul dua petang,",
  "start": 47.81,
  "end": 48.47
 },
 {
  "para": 6,
  "text": "Hospital Umum Sarawak.",
  "start": 48.72,
  "end": 49.94
 },
 {
  "para": 6,
  "text": "Dua biji sehari…",
  "start": 49.94,
  "end": 51.15
 },
 {
  "para": 6,
  "text": "atau dua puluh?",
  "start": 51.44,
  "end": 52.52
 },
 {
  "para": 6,
  "text": "Doktor tak berani beri ubat.",
  "start": 52.95,
  "end": 54.74
 },
 {
  "para": 7,
  "text": "Pukul empat.",
  "start": 55.27,
  "end": 55.68
 },
 {
  "para": 7,
  "text": "Jambatan baru di Waterfront dibina dari dua tebing…",
  "start": 55.97,
  "end": 58.72
 },
 {
  "para": 7,
  "text": "dan tak bertemu di tengah sungai.",
  "start": 59.01,
  "end": 60.57
 },
 {
  "para": 8,
  "text": "Pukul enam.",
  "start": 61.1,
  "end": 61.59
 },
 {
  "para": 8,
  "text": "Loji air tak boleh sukat klorin.",
  "start": 61.87,
  "end": 63.48
 },
 {
  "para": 8,
  "text": "Janakuasa tak boleh kira voltan.",
  "start": 63.76,
  "end": 65.57
 },
 {
  "para": 8,
  "text": "Air paip berhenti.",
  "start": 65.85,
  "end": 66.73
 },
 {
  "para": 8,
  "text": "Lampu padam.",
  "start": 67.02,
  "end": 67.54
 },
 {
  "para": 9,
  "text": "Pukul sembilan malam.",
  "start": 68.06,
  "end": 68.74
 },
 {
  "para": 9,
  "text": "Kuching gelap gelita.",
  "start": 69.03,
  "end": 70.14
 },
 {
  "para": 9,
  "text": "Bantuan tak tahu berapa ramai perlu ditolong…",
  "start": 70.43,
  "end": 72.66
 },
 {
  "para": 9,
  "text": "atau berapa jauh perlu pergi.",
  "start": 72.94,
  "end": 74.48
 },
 {
  "para": 10,
  "text": "Baru kita sedar.",
  "start": 75.0,
  "end": 75.84
 },
 {
  "para": 10,
  "text": "Matematik bukan cuma dalam kelas.",
  "start": 76.13,
  "end": 77.87
 },
 {
  "para": 10,
  "text": "Ia ada dalam laksa pagi kita,",
  "start": 78.15,
  "end": 80.18
 },
 {
  "para": 10,
  "text": "jambatan yang kita lalu,",
  "start": 80.42,
  "end": 81.46
 },
 {
  "para": 10,
  "text": "air yang kita minum —",
  "start": 81.75,
  "end": 82.53
 },
 {
  "para": 10,
  "text": "dan setiap nyawa yang diselamatkan.",
  "start": 82.96,
  "end": 84.7
 },
 {
  "para": 11,
  "text": "Apa jadi kalau…",
  "start": 85.22,
  "end": 86.09
 },
 {
  "para": 11,
  "text": "apa pula?",
  "start": 86.38,
  "end": 86.84
 },
 {
  "para": 11,
  "text": "Tulis di ruang komen.",
  "start": 87.27,
  "end": 87.93
 }
]