[
 {
  "para": 0,
  "text": "Esok pagi,",
  "start": 0.04,
  "end": 3.4
 },
 {
  "para": 0,
  "text": "semua orang di Kuching bangun…",
  "start": 3.52,
  "end": 5.94
 },
 {
  "para": 0,
  "text": "dan tiba-tiba tak pandai matematik.",
  "start": 6.02,
  "end": 9.12
 },
 {
  "para": 0,
  "text": "Jam loceng berbunyi —",
  "start": 9.24,
  "end": 10.52
 },
 {
  "para": 0,
  "text": "tapi tiada siapa tahu pukul berapa.",
  "start": 10.68,
  "end": 12.92
 },
 {
  "para": 1,
  "text": "Pukul tujuh setengah,",
  "start": 13.24,
  "end": 14.26
 },
 {
  "para": 1,
  "text": "gerai laksa.",
  "start": 14.36,
  "end": 15.36
 },
 {
  "para": 1,
  "text": "Semangkuk laksa Sarawak lapan ringgit.",
  "start": 15.5,
  "end": 18.26
 },
 {
  "para": 1,
  "text": "Anda bayar sepuluh —",
  "start": 18.36,
  "end": 19.42
 },
 {
  "para": 1,
  "text": "peniaga pulangkan lapan puluh.",
  "start": 19.56,
  "end": 21.1
 },
 {
  "para": 2,
  "text": "Pukul sembilan,",
  "start": 21.56,
  "end": 22.32
 },
 {
  "para": 2,
  "text": "di Medan Niaga Satok.",
  "start": 22.46,
  "end": 23.78
 },
 {
  "para": 2,
  "text": "Nak beli ikan terubuk masin.",
  "start": 23.88,
  "end": 25.34
 },
 {
  "para": 2,
  "text": "Penimbang tunjuk dua kilo —",
  "start": 25.58,
  "end": 27.22
 },
 {
  "para": 2,
  "text": "peniaga baca dua puluh.",
  "start": 27.42,
  "end": 29.16
 },
 {
  "para": 2,
  "text": "Diskaun lima puluh peratus —",
  "start": 29.28,
  "end": 30.44
 },
 {
  "para": 2,
  "text": "harga jadi lebih mahal.",
  "start": 30.58,
  "end": 31.94
 },
 {
  "para": 3,
  "text": "Pukul sepuluh.",
  "start": 32.44,
  "end": 33.22
 },
 {
  "para": 3,
  "text": "Hari gaji.",
  "start": 33.38,
  "end": 34.48
 },
 {
  "para": 3,
  "text": "Tapi tiada siapa boleh kira baki akaun.",
  "start": 34.64,
  "end": 37.72
 },
 {
  "para": 3,
  "text": "Bank tutup kaunter.",
  "start": 37.92,
  "end": 39.32
 },
 {
  "para": 4,
  "text": "Pukul sebelas.",
  "start": 39.82,
  "end": 40.72
 },
 {
  "para": 4,
  "text": "Had laju tak bermakna apa-apa.",
  "start": 41.08,
  "end": 42.7
 },
 {
  "para": 4,
  "text": "Pam minyak tak tahu bila nak berhenti.",
  "start": 42.88,
  "end": 44.98
 },
 {
  "para": 4,
  "text": "Jalan raya lumpuh.",
  "start": 45.08,
  "end": 46.36
 },
 {
  "para": 5,
  "text": "Tengah hari,",
  "start": 46.8,
  "end": 48.12
 },
 {
  "para": 5,
  "text": "Lapangan Terbang Antarabangsa Kuching.",
  "start": 48.22,
  "end": 50.1
 },
 {
  "para": 5,
  "text": "Juruterbang tak boleh kira bahan api atau ketinggian.",
  "start": 50.2,
  "end": 55.1
 },
 {
  "para": 5,
  "text": "Semua penerbangan —",
  "start": 55.24,
  "end": 56.34
 },
 {
  "para": 5,
  "text": "dibatalkan.",
  "start": 56.72,
  "end": 57.08
 },
 {
  "para": 6,
  "text": "Pukul dua petang,",
  "start": 57.5,
  "end": 58.4
 },
 {
  "para": 6,
  "text": "Hospital Umum Sarawak.",
  "start": 58.48,
  "end": 60.32
 },
 {
  "para": 6,
  "text": "Dua biji sehari…",
  "start": 60.44,
  "end": 61.8
 },
 {
  "para": 6,
  "text": "atau dua puluh?",
  "start": 61.9,
  "end": 63.32
 },
 {
  "para": 6,
  "text": "Doktor tak berani beri ubat.",
  "start": 63.44,
  "end": 65.06
 },
 {
  "para": 7,
  "text": "Pukul empat.",
  "start": 65.44,
  "end": 66.46
 },
 {
  "para": 7,
  "text": "Jambatan baru di Waterfront dibina dari dua tebing…",
  "start": 66.58,
  "end": 69.96
 },
 {
  "para": 7,
  "text": "dan tak bertemu di tengah sungai.",
  "start": 70.08,
  "end": 72.54
 },
 {
  "para": 8,
  "text": "Pukul enam.",
  "start": 72.92,
  "end": 74.04
 },
 {
  "para": 8,
  "text": "Loji air tak boleh sukat klorin.",
  "start": 74.08,
  "end": 76.38
 },
 {
  "para": 8,
  "text": "Janakuasa tak boleh kira voltan.",
  "start": 76.24,
  "end": 78.06
 },
 {
  "para": 8,
  "text": "Air paip berhenti.",
  "start": 78.14,
  "end": 79.8
 },
 {
  "para": 8,
  "text": "Lampu padam.",
  "start": 79.9,
  "end": 80.56
 },
 {
  "para": 9,
  "text": "Pukul sembilan malam.",
  "start": 80.8,
  "end": 83.38
 },
 {
  "para": 9,
  "text": "Kuching gelap gelita.",
  "start": 83.54,
  "end": 85.26
 },
 {
  "para": 9,
  "text": "Bantuan tak tahu berapa ramai perlu ditolong…",
  "start": 85.4,
  "end": 88.18
 },
 {
  "para": 9,
  "text": "atau berapa jauh perlu pergi.",
  "start": 88.28,
  "end": 91.1
 },
 {
  "para": 10,
  "text": "Baru kita sedar.",
  "start": 91.46,
  "end": 92.84
 },
 {
  "para": 10,
  "text": "Matematik bukan cuma dalam kelas.",
  "start": 92.94,
  "end": 95.2
 },
 {
  "para": 10,
  "text": "Ia ada dalam laksa pagi kita,",
  "start": 95.38,
  "end": 98.02
 },
 {
  "para": 10,
  "text": "jambatan yang kita lalu,",
  "start": 98.12,
  "end": 102.44
 },
 {
  "para": 10,
  "text": "air yang kita minum —",
  "start": 102.54,
  "end": 104.48
 },
 {
  "para": 10,
  "text": "dan setiap nyawa yang diselamatkan.",
  "start": 104.62,
  "end": 107.88
 },
 {
  "para": 11,
  "text": "Apa jadi kalau…",
  "start": 108.34,
  "end": 109.52
 },
 {
  "para": 11,
  "text": "apa pula?",
  "start": 109.64,
  "end": 111.1
 },
 {
  "para": 11,
  "text": "Tulis di ruang komen.",
  "start": 111.26,
  "end": 112.94
 }
]