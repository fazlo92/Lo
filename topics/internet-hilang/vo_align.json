[
 {
  "para": 0,
  "text": "Bayangkan…",
  "start": 0.02,
  "end": 0.84
 },
 {
  "para": 0,
  "text": "esok pagi,",
  "start": 0.96,
  "end": 1.76
 },
 {
  "para": 0,
  "text": "internet di seluruh dunia hilang.",
  "start": 1.88,
  "end": 3.86
 },
 {
  "para": 0,
  "text": "Selama tujuh hari.",
  "start": 3.98,
  "end": 5.44
 },
 {
  "para": 1,
  "text": "Hari pertama.",
  "start": 5.94,
  "end": 6.6
 },
 {
  "para": 1,
  "text": "Pukul 7 pagi di Kuching.",
  "start": 6.76,
  "end": 8.48
 },
 {
  "para": 1,
  "text": "WhatsApp,",
  "start": 8.05,
  "end": 9.4
 },
 {
  "para": 1,
  "text": "Facebook dan TikTok tidak boleh dibuka.",
  "start": 8.6,
  "end": 12.08
 },
 {
  "para": 1,
  "text": "Di sebuah kedai makan di Satok,",
  "start": 12.2,
  "end": 13.8
 },
 {
  "para": 1,
  "text": "bayaran Sarawak Pay gagal.",
  "start": 13.92,
  "end": 15.86
 },
 {
  "para": 1,
  "text": "Peniaga hanya berkata,",
  "start": 16.0,
  "end": 17.1
 },
 {
  "para": 1,
  "text": "“Cash jak boleh!”",
  "start": 17.05,
  "end": 17.87
 },
 {
  "para": 1,
  "text": "Ramai masih tenang.",
  "start": 18.15,
  "end": 18.98
 },
 {
  "para": 2,
  "text": "Hari kedua.",
  "start": 19.6,
  "end": 20.5
 },
 {
  "para": 2,
  "text": "Semua orang mencari wang tunai.",
  "start": 20.62,
  "end": 22.72
 },
 {
  "para": 2,
  "text": "Di Samarahan,",
  "start": 22.84,
  "end": 23.62
 },
 {
  "para": 2,
  "text": "barisan panjang di mesin ATM.",
  "start": 23.74,
  "end": 25.8
 },
 {
  "para": 2,
  "text": "Di Pasar Serikin,",
  "start": 25.94,
  "end": 27.08
 },
 {
  "para": 2,
  "text": "peniaga kembali kepada tunai.",
  "start": 27.1,
  "end": 28.6
 },
 {
  "para": 3,
  "text": "Hari ketiga.",
  "start": 29.12,
  "end": 30.04
 },
 {
  "para": 3,
  "text": "Di Pelabuhan Bintulu dan Sibu,",
  "start": 30.14,
  "end": 31.96
 },
 {
  "para": 3,
  "text": "penghantaran semakin perlahan.",
  "start": 32.14,
  "end": 33.82
 },
 {
  "para": 3,
  "text": "Barang masih ada di gudang…",
  "start": 33.94,
  "end": 35.38
 },
 {
  "para": 3,
  "text": "tetapi sukar dihantar.",
  "start": 35.54,
  "end": 36.94
 },
 {
  "para": 4,
  "text": "Hari keempat.",
  "start": 37.46,
  "end": 38.24
 },
 {
  "para": 4,
  "text": "Di Kuching dan Miri,",
  "start": 38.34,
  "end": 39.44
 },
 {
  "para": 4,
  "text": "beberapa rak pasar raya mula kosong.",
  "start": 39.58,
  "end": 41.54
 },
 {
  "para": 4,
  "text": "Di Hospital Umum Sarawak,",
  "start": 41.68,
  "end": 43.08
 },
 {
  "para": 4,
  "text": "petugas menggunakan prosedur sandaran.",
  "start": 43.14,
  "end": 45.1
 },
 {
  "para": 4,
  "text": "Rawatan kecemasan tetap diteruskan.",
  "start": 45.22,
  "end": 47.48
 },
 {
  "para": 5,
  "text": "Hari kelima.",
  "start": 47.47,
  "end": 48.84
 },
 {
  "para": 5,
  "text": "Di pedalaman Kapit dan Belaga,",
  "start": 48.96,
  "end": 50.66
 },
 {
  "para": 5,
  "text": "penduduk tidak dapat menghubungi keluarga.",
  "start": 50.86,
  "end": 52.76
 },
 {
  "para": 5,
  "text": "Mereka kembali bergantung kepada radio.",
  "start": 52.88,
  "end": 54.74
 },
 {
  "para": 5,
  "text": "Di bandar,",
  "start": 54.88,
  "end": 55.46
 },
 {
  "para": 5,
  "text": "khabar angin tersebar: internet tidak akan kembali.",
  "start": 55.62,
  "end": 58.56
 },
 {
  "para": 6,
  "text": "Hari keenam.",
  "start": 59.04,
  "end": 60.34
 },
 {
  "para": 6,
  "text": "Perniagaan kecil kehilangan tempahan dalam talian.",
  "start": 60.52,
  "end": 62.88
 },
 {
  "para": 6,
  "text": "Kerugian semakin meningkat.",
  "start": 63.14,
  "end": 64.62
 },
 {
  "para": 7,
  "text": "Hari ketujuh.",
  "start": 65.08,
  "end": 66.54
 },
 {
  "para": 7,
  "text": "Sarawak bertahan.",
  "start": 66.66,
  "end": 67.92
 },
 {
  "para": 7,
  "text": "Pasar masih dibuka.",
  "start": 68.12,
  "end": 69.52
 },
 {
  "para": 7,
  "text": "Di kampung,",
  "start": 69.66,
  "end": 70.36
 },
 {
  "para": 7,
  "text": "penduduk masih bercucuk tanam dan menangkap ikan.",
  "start": 70.52,
  "end": 72.68
 },
 {
  "para": 7,
  "text": "Jiran saling membantu.",
  "start": 72.8,
  "end": 74.24
 },
 {
  "para": 8,
  "text": "Tepat tengah malam…",
  "start": 74.76,
  "end": 75.8
 },
 {
  "para": 8,
  "text": "internet kembali.",
  "start": 75.9,
  "end": 77.04
 },
 {
  "para": 8,
  "text": "Telefon menerima mesej bertalu-talu.",
  "start": 77.26,
  "end": 79.4
 },
 {
  "para": 9,
  "text": "Tujuh hari tanpa internet tidak memusnahkan Sarawak.",
  "start": 79.98,
  "end": 83.04
 },
 {
  "para": 9,
  "text": "Tetapi cukup untuk menunjukkan betapa kita bergantung kepadanya.",
  "start": 83.22,
  "end": 87.14
 },
 {
  "para": 10,
  "text": "Apa jadi kalau…",
  "start": 87.15,
  "end": 88.66
 },
 {
  "para": 10,
  "text": "perkara lain pula berlaku?",
  "start": 88.8,
  "end": 90.22
 },
 {
  "para": 10,
  "text": "Tulis idea anda di ruang komen!",
  "start": 90.38,
  "end": 91.94
 }
]